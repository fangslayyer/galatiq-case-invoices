# xAI API key — required: Grok is the pipeline's only reasoning engine
XAI_API_KEY=

# Optional overrides (defaults shown)
# INVOICEFLOW_GROK_MODEL=grok-4.6
# INVOICEFLOW_SCRUTINY_THRESHOLD=10000

# --- LangSmith tracing — DEVELOPMENT ONLY, off unless you uncomment ----------
# Streams every agent call, tool loop and critique round to smith.langchain.com
# for inspection. It sends prompts and invoice contents to LangSmith's cloud,
# so keep it off for anything resembling real invoice data. Forced off in tests.
# The client is a dev dependency (`uv sync`); `uv sync --no-dev` runs without it.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=invoiceflow
